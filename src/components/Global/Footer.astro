---
interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
}

const { render = true } = Astro.props;

// Torn edge, generated once at build time (seeded, so it never shifts).
const rng = (a: number) => () => {
  a = (a + 0x6d2b79f5) >>> 0;
  let t = a;
  t = Math.imul(t ^ (t >>> 15), t | 1);
  t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const r = rng(7);
const N = 48;
const f = (n: number) => n.toFixed(2);
const xs = Array.from({ length: N }, (_, i) => -1 + (i / (N - 1)) * 102);
const ys = xs.map((x) => {
  const d = Math.min(1, Math.abs(x - 50) / 50);
  const jag = (r() - 0.5) * (r() < 0.16 ? 5 : 2.2);
  return Math.min(80, 50 + 30 * d ** 1.35 + Math.sin(x * 0.31) * 1.6 + jag);
});
const poly = (v: number[]) =>
  "polygon(-1% -2%, 101% -2%, " +
  v
    .map((y, i) => [xs[i], y])
    .reverse()
    .map(([x, y]) => `${f(x)}% ${f(y)}%`)
    .join(", ") +
  ")";
const below = ys.map(() => 108);
const rim = ys.map((y) => y + 0.5 + r() * 0.9);
const vars = `--sheet-to:${poly(ys)};--sheet-from:${poly(below)};--rim-to:${poly(rim)};--rim-from:${poly(below)}`;

const year = new Date().getFullYear();
---

{
  render && (
    <footer class="foot" style={vars} data-foot>
      <div class="foot_tear" aria-hidden="true">
        <div class="foot_rim" />
        <div class="foot_sheet" />
      </div>

      <div class="foot_top">
        <nav aria-label="Footer" class="foot_h" style="--i:0">
          <ul class="foot_links">
            <li><a href="/">Home</a></li>
            <li><a href="/example-components">Example Components</a></li>
          </ul>
        </nav>

        <a class="foot_logo foot_h" style="--i:1" href="/" aria-label="Colbe">
          <svg viewBox="0 0 44 28" aria-hidden="true">
            <path
              class="foot_c"
              d="M30 6.5c-1.6-1.8-3.8-2.8-6.4-2.8C17.3 3.7 12.5 8.2 12.5 14s4.8 10.3 11.1 10.3c2.6 0 4.8-1 6.4-2.8"
            />
            <circle class="foot_dot" cx="32" cy="5" r="3.2" />
          </svg>
        </a>

        <button
          type="button"
          class="foot_up foot_h"
          style="--i:2"
          aria-label="Back to top"
          data-top
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m5.5 14.5 6.5-6.5 6.5 6.5" />
          </svg>
        </button>
      </div>

      <button type="button" class="foot_pin" aria-label="Pull the pin" data-pin>
        <span class="foot_pin_shadow" aria-hidden="true" />
        <span class="foot_pin_drop">
          <svg viewBox="0 0 100 200" aria-hidden="true">
            <defs>
              <linearGradient id="fpS" x1="0" x2="1">
                <stop offset="0" stop-color="#8f2208" />
                <stop offset=".3" stop-color="#ff6a45" />
                <stop offset=".42" stop-color="#ffc2ae" />
                <stop offset=".6" stop-color="#ee4a22" />
                <stop offset="1" stop-color="#6b1804" />
              </linearGradient>
              <radialGradient id="fpT" cx=".38" cy=".3" r=".8">
                <stop offset="0" stop-color="#ffb199" />
                <stop offset=".55" stop-color="#f2512b" />
                <stop offset="1" stop-color="#8f2208" />
              </radialGradient>
              <linearGradient id="fpN" x1="0" x2="1">
                <stop offset="0" stop-color="#5b616b" />
                <stop offset=".4" stop-color="#f4f5f7" />
                <stop offset="1" stop-color="#4a4f57" />
              </linearGradient>
            </defs>
            <path d="M48.3 112h3.4l-.7 76-1 4-1-4z" fill="url(#fpN)" />
            <path d="M28 103v6.5a22 7 0 0 0 44 0V103z" fill="url(#fpS)" />
            <ellipse cx="50" cy="103" rx="22" ry="7" fill="url(#fpT)" />
            <path d="M41.5 38c1.6 16 4.6 26 3 36-1.8 10-13 19-14.6 29h40.2c-1.6-10-12.8-19-14.6-29-1.6-10 1.4-20 3-36z" fill="url(#fpS)" />
            <path d="M16 22v14a34 13 0 0 0 68 0V22z" fill="url(#fpS)" />
            <ellipse cx="50" cy="22" rx="34" ry="13" fill="url(#fpT)" />
            <ellipse cx="37" cy="17.5" rx="12" ry="4" fill="#fff" opacity=".6" />
          </svg>
        </span>
      </button>

      <div class="foot_paper">
        <a class="foot_word foot_p" style="--i:0" href="/" aria-label="Colbe">
          <span>colbe.</span>
        </a>
        <p class="foot_copy foot_p" style="--i:1">
          &copy; <span id="year">{year}</span>&#160;Colbe
        </p>
      </div>
    </footer>
  )
}

<script>
  const foot = document.querySelector<HTMLElement>("[data-foot]");
  if (foot) {
    foot.classList.add("is-armed");
    new IntersectionObserver(
      ([e], io) => {
        if (e.isIntersecting) {
          foot.classList.add("is-in");
          io.disconnect();
        }
      },
      { threshold: 0.25 },
    ).observe(foot);

    foot.querySelector("[data-top]")?.addEventListener("click", () =>
      window.scrollTo({ top: 0, behavior: "smooth" }),
    );

    const pin = foot.querySelector<HTMLElement>("[data-pin]");
    pin?.addEventListener("click", () => {
      pin.dataset.state = "";
      void pin.offsetWidth;
      pin.dataset.state = "stab";
    });
  }
</script>

<style is:global>
  @layer components {
    .foot {
      --foot-sheet: #f2512b;
      --foot-paper: #f3f1ec;
      --foot-on-sheet: #fff;
      --foot-ink: #1a1917;
      --ease: cubic-bezier(0.22, 1, 0.36, 1);
      position: relative;
      isolation: isolate;
      overflow: hidden;
      container-type: inline-size;
      min-height: clamp(30rem, 62vw, 42rem);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      background: var(--foot-paper);
      color: var(--foot-ink);
    }

    /* torn sheet */
    .foot_tear {
      position: absolute;
      inset: 0;
      z-index: 0;
      filter: drop-shadow(0 4px 5px rgb(20 10 5 / 0.28));
    }
    .foot_rim,
    .foot_sheet {
      position: absolute;
      inset: 0;
      transition: clip-path 1.5s cubic-bezier(0.2, 1.15, 0.3, 1) 0.55s;
    }
    .foot_rim {
      background: #fff;
      clip-path: var(--rim-to);
    }
    .foot_sheet {
      background: var(--foot-sheet);
      clip-path: var(--sheet-to);
    }
    .foot.is-armed:not(.is-in) .foot_rim {
      clip-path: var(--rim-from);
      transition: none;
    }
    .foot.is-armed:not(.is-in) .foot_sheet {
      clip-path: var(--sheet-from);
      transition: none;
    }

    /* top bar */
    .foot_top {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 1rem;
      padding: clamp(1.25rem, 3vw, 2.5rem) var(--site-margin, 1.5rem);
      color: var(--foot-on-sheet);
    }
    .foot_links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem 1.25rem;
      margin: 0;
      padding: 0;
      list-style: none;
      font-size: var(--text-small, 0.95rem);
    }
    .foot_links a {
      color: inherit;
      text-decoration: none;
      background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px
        no-repeat;
      transition: background-size 0.4s var(--ease);
    }
    @media (hover: hover) {
      .foot_links a:hover {
        background-size: 100% 1px;
      }
    }
    .foot_logo {
      display: block;
      color: inherit;
    }
    .foot_logo svg {
      display: block;
      width: 3.4rem;
      overflow: visible;
      fill: none;
      stroke: currentColor;
      stroke-width: 3;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .foot_c {
      stroke-dasharray: 60;
      stroke-dashoffset: 0;
      transition: stroke-dashoffset 1.3s var(--ease) 0.15s;
    }
    .foot_dot {
      fill: currentColor;
      stroke: none;
      transform-box: fill-box;
      transform-origin: 50% 50%;
      transition: transform 0.6s cubic-bezier(0.5, 1.8, 0.4, 1) 0.9s;
    }
    .foot.is-armed:not(.is-in) .foot_c {
      stroke-dashoffset: 60;
    }
    .foot.is-armed:not(.is-in) .foot_dot {
      transform: scale(0);
    }
    @media (hover: hover) {
      .foot_logo:hover .foot_dot {
        animation: foot-bob 0.7s var(--ease);
      }
    }
    .foot_up {
      justify-self: end;
      display: grid;
      place-items: center;
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 50%;
      color: inherit;
      cursor: pointer;
      transition:
        transform 0.35s var(--ease),
        background-color 0.25s;
    }
    .foot_up svg {
      width: 1.4rem;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    @media (hover: hover) {
      .foot_up:hover {
        transform: translateY(-3px);
        background: rgb(255 255 255 / 0.18);
      }
    }

    /* pin */
    .foot_pin {
      position: absolute;
      z-index: 3;
      left: 50%;
      top: 63%;
      width: clamp(2.6rem, 8cqw, 4.5rem);
      aspect-ratio: 1 / 2;
      transform: translate(-50%, -100%) rotate(5deg);
      transform-origin: 50% 100%;
      cursor: pointer;
      background: none;
      border: 0;
      padding: 0;
    }
    .foot_pin_drop {
      position: absolute;
      inset: 0;
      transform-origin: 50% 100%;
      transition: transform 0.35s var(--ease);
    }
    .foot_pin_drop svg {
      width: 100%;
      height: 100%;
      display: block;
      overflow: visible;
    }
    .foot_pin_shadow {
      position: absolute;
      right: 50%;
      bottom: 0;
      width: 150%;
      height: 14%;
      transform: rotate(16deg);
      transform-origin: 100% 50%;
      border-radius: 50%;
      background: linear-gradient(90deg, transparent, rgb(9 22 48 / 0.4));
      filter: blur(3px);
    }
    .foot.is-armed:not(.is-in) .foot_pin {
      opacity: 0;
    }
    .foot.is-in .foot_pin_drop {
      animation: foot-drop 0.62s cubic-bezier(0.5, 0, 0.75, 0) both;
    }
    @media (hover: hover) {
      .foot_pin:hover .foot_pin_drop {
        transform: translateY(-4%);
      }
    }
    .foot_pin[data-state="stab"] .foot_pin_drop {
      animation: foot-stab 0.5s cubic-bezier(0.55, 0, 0.8, 0.2) both;
    }

    /* paper */
    .foot_paper {
      position: relative;
      z-index: 2;
      display: grid;
      justify-items: center;
      gap: 0.5rem;
      padding: 0 var(--site-margin, 1.5rem) clamp(1rem, 2.5vw, 1.75rem);
      margin-top: auto;
    }
    .foot_word {
      display: block;
      overflow: hidden;
      padding: 0 0.04em 0.12em;
      color: var(--foot-sheet);
      text-decoration: none;
      font-family: var(--font-display, "Instrument Serif", Georgia, serif);
      font-size: clamp(4rem, 21cqw, 14rem);
      line-height: 0.95;
      letter-spacing: -0.04em;
    }
    .foot_word span {
      display: block;
      position: relative;
      transition: transform 1s var(--ease) 0.5s;
    }
    .foot_word span::after {
      content: "";
      position: absolute;
      left: 0.02em;
      right: 0.04em;
      bottom: 0;
      height: max(2px, 0.03em);
      background: currentColor;
      transform-origin: 0 50%;
      transition: transform 0.9s var(--ease) 1.05s;
    }
    .foot.is-armed:not(.is-in) .foot_word span {
      transform: translateY(125%);
      transition-delay: 0s;
    }
    .foot.is-armed:not(.is-in) .foot_word span::after {
      transform: scaleX(0);
      transition-delay: 0s;
    }
    .foot_copy {
      margin: 0;
      font-size: var(--text-small, 0.85rem);
      color: color-mix(in srgb, var(--foot-ink) 65%, var(--foot-paper));
    }

    /* assemble on scroll-in */
    .foot_h {
      transition:
        opacity 0.7s var(--ease),
        translate 0.8s var(--ease),
        filter 0.7s var(--ease),
        transform 0.35s var(--ease),
        background-color 0.25s;
      transition-delay: calc(var(--i, 0) * 70ms);
    }
    .foot_p {
      transition:
        opacity 0.8s var(--ease),
        translate 0.9s var(--ease),
        filter 0.8s var(--ease);
      transition-delay: calc(600ms + var(--i, 0) * 80ms);
    }
    .foot.is-armed:not(.is-in) .foot_h {
      opacity: 0;
      translate: 0 10px;
      filter: blur(6px);
    }
    .foot.is-armed:not(.is-in) .foot_copy {
      opacity: 0;
      translate: 0 14px;
      filter: blur(6px);
      transition-delay: 0s;
    }

    @container (max-width: 620px) {
      .foot_top {
        grid-template-columns: 1fr auto;
      }
      .foot_logo {
        order: -1;
      }
      .foot_links {
        grid-column: 1 / -1;
        grid-row: 2;
      }
    }

    @keyframes foot-drop {
      0% {
        transform: translateY(-60cqh) rotate(-28deg) scale(1.5);
        opacity: 0;
      }
      25% {
        opacity: 1;
      }
      80% {
        transform: translateY(0) rotate(3deg) scale(1);
      }
      90% {
        transform: scale(1.04, 0.95);
      }
      100% {
        transform: none;
        opacity: 1;
      }
    }
    @keyframes foot-stab {
      0% {
        transform: translateY(-22%) rotate(-10deg);
      }
      70% {
        transform: translateY(1.5%) rotate(1deg);
      }
      100% {
        transform: none;
      }
    }
    @keyframes foot-bob {
      40% {
        transform: translateY(-3px) scale(1.15);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .foot *,
      .foot *::before,
      .foot *::after {
        animation: none !important;
        transition-duration: 0.01s !important;
        transition-delay: 0s !important;
      }
    }
  }
</style>